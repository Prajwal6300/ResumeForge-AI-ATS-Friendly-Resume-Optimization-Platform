{
  "name": "resumeforge-ai",
  "version": "1.0.0",
  "private": true,
  "description": "ResumeForge AI - AI-Powered ATS Resume Optimization & Job Matching Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:api": "python -m uvicorn app.main:app --app-dir apps/api --reload --port 8000",
    "build": "npm --workspaces run build",
    "typecheck": "npm --workspaces run typecheck",
    "lint": "npm --workspaces run lint",
    "test": "npm --workspaces run test"
  },
  "keywords": [
    "resume",
    "ats",
    "ai",
    "job-matching",
    "career",
    "optimization"
  ],
  "author": "ResumeForge AI Team",
  "license": "MIT"
}
