# ==============================================================================
# ResumeForge AI - Frontend Environment Configuration (.env.example)
# ==============================================================================
# In production on Vercel, set this to your deployed API base URL:
# - With separate Render/VPS backend: NEXT_PUBLIC_API_URL=https://<render-service>.onrender.com/api/v1
# - With backend also on Vercel:      NEXT_PUBLIC_API_URL=https://<your-vercel-project>.vercel.app/api/v1
# In local development:                NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
#
# This variable is REQUIRED. The frontend will fail to compile with a clear
# error message in production if it is missing.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1