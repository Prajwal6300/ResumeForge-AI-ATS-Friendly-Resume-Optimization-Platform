# ==============================================================================
# ResumeForge AI - Backend Environment Configuration (.env.example)
# ==============================================================================

# Application Environment ("development" | "production" | "test")
ENVIRONMENT=production
DEBUG=False
APP_NAME="ResumeForge AI"
APP_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate a secure 64-character secret key for production: `openssl rand -hex 32`
SECRET_KEY=REQUIRED_FROM_USER_GENERATE_WITH_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database Configuration
# Production (Supabase PostgreSQL):
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Session Pooler: postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.co:5432/postgres
DATABASE_URL=
# Optional sync URL override (derived automatically from DATABASE_URL if empty):
SYNC_DATABASE_URL=

# CORS Allowed Origins (Comma-separated exact origins, NO wildcards in production)
# Example: https://resume-forge-ai-ats-friendly-resume.vercel.app
CORS_ORIGINS=https://resume-forge-ai-ats-friendly-resume.vercel.app
ALLOWED_ORIGINS=https://resume-forge-ai-ats-friendly-resume.vercel.app

# File Storage Configuration ("local" | "s3")
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# S3 Object Storage (Required only when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# AI Provider Configuration ("openai" | "anthropic" | "gemini" | "ollama" | "mock")
DEFAULT_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ATS Scoring Weights (Must sum to exactly 100%)
ATS_WEIGHT_KEYWORD_RELEVANCE=40.0
ATS_WEIGHT_TECHNICAL_SKILLS=25.0
ATS_WEIGHT_RESPONSIBILITIES=20.0
ATS_WEIGHT_EXPERIENCE_RELEVANCE=10.0
ATS_WEIGHT_RESUME_STRUCTURE=5.0
