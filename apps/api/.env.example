# ==============================================================================
# ResumeForge AI - Backend Environment Configuration (.env.example)
# ==============================================================================

# Application Environment ("development" | "production" | "test")
ENVIRONMENT=development
DEBUG=True
APP_NAME="ResumeForge AI"
APP_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate a secure 64-char secret key for production: `openssl rand -hex 32`
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database Configuration
# Production (Supabase PostgreSQL pooler):
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.co:5432/postgres
# Auto-converted from postgres:// or postgresql:// to postgresql+asyncpg://
# Local development default: sqlite+aiosqlite:///./resumeforge.db
DATABASE_URL=sqlite+aiosqlite:///./resumeforge.db
# Optional sync URL override (derived automatically from DATABASE_URL if empty):
# SYNC_DATABASE_URL=

# CORS Allowed Origins (Comma-separated exact origins, NO wildcards in production when credentials enabled)
# Example: https://resume-forge-ai-ats-friendly-resume.vercel.app,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=https://resume-forge-ai-ats-friendly-resume.vercel.app,http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=https://resume-forge-ai-ats-friendly-resume.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# File Storage Configuration ("local" | "s3")
# "local" uses ./uploads (development only, not persistent on Render/Vercel free tier)
# "s3" uses S3-compatible backend (Supabase Storage, Cloudflare R2, MinIO, etc.)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx

# S3 Configuration (required when STORAGE_BACKEND=s3)
S3_BUCKET=resumeforge-storage
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=MINIO_ACCESS_KEY_OR_SUPABASE_S3_KEY
S3_SECRET_ACCESS_KEY=MINIO_SECRET_KEY_OR_SUPABASE_S3_SECRET
S3_ENDPOINT_URL=https://supabase-storage.region.supabase.co

# AI Provider Configuration ("openai" | "anthropic" | "gemini" | "ollama" | "mock")
DEFAULT_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ATS Scoring Weights (Must sum to exactly 100%)
ATS_WEIGHT_KEYWORD_RELEVANCE=40.0
ATS_WEIGHT_TECHNICAL_SKILLS=25.0
ATS_WEIGHT_RESPONSIBILITIES=20.0
ATS_WEIGHT_EXPERIENCE_RELEVANCE=10.0
ATS_WEIGHT_RESUME_STRUCTURE=5.0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1