# ==============================================================================
# ResumeForge AI - Environment Configuration Example
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="ResumeForge AI"
APP_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate a secure 64-char string for production: `openssl rand -hex 32`
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database Configuration
# PostgreSQL (Production / Docker): postgresql+asyncpg://postgres:postgres@localhost:5432/resumeforge
# SQLite (Local Development / Testing default): sqlite+aiosqlite:///./resumeforge.db
DATABASE_URL=sqlite+aiosqlite:///./resumeforge.db
SYNC_DATABASE_URL=sqlite:///./resumeforge.db

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload & Storage Configuration
# Storage backend options: "local" | "s3"
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# S3 Configuration (when STORAGE_BACKEND=s3)
S3_BUCKET=resumeforge-storage
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# AI Provider Configuration
# Active provider: "openai" | "anthropic" | "gemini" | "ollama" | "mock"
DEFAULT_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ATS Scoring Weights (Must sum to 100%)
ATS_WEIGHT_KEYWORD_RELEVANCE=40
ATS_WEIGHT_TECHNICAL_SKILLS=25
ATS_WEIGHT_RESPONSIBILITIES=20
ATS_WEIGHT_EXPERIENCE_RELEVANCE=10
ATS_WEIGHT_RESUME_STRUCTURE=5

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
